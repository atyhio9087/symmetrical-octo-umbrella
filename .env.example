# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# AI_PROVIDER: which backend server.ts routes generation calls to. Leave unset
# (or "gemini") for the original Google Gemini behavior. Only ONE provider's
# variables need to be set, matching whichever AI_PROVIDER you choose.
# ---------------------------------------------------------------------------
# AI_PROVIDER="gemini"

# --- Gemini (default) ---
# GEMINI_API_KEY: Required when AI_PROVIDER is unset or "gemini".
# Get one from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Ollama (local models, e.g. for dev/testing without API cost) ---
# AI_PROVIDER="ollama"
# OLLAMA_BASE_URL="http://localhost:11434"   # optional, this is the default
# OLLAMA_MODEL="gemma3"                      # optional, e.g. "gemma3:27b"

# --- Databricks Foundation Model API (e.g. Gemma 3 hosted in your workspace) ---
# AI_PROVIDER="databricks"
# DATABRICKS_HOST="https://adb-XXXXXXXXXXXXXXXX.XX.azuredatabricks.net"
# DATABRICKS_TOKEN="dapi..."                 # PAT or service principal OAuth token
# DATABRICKS_MODEL_ENDPOINT="my-gemma3-endpoint"  # the serving endpoint name

# APIFY_API_KEY: Required only for the LinkedIn Research Agent feature.
# APIFY_API_KEY="MY_APIFY_API_KEY"

# ---------------------------------------------------------------------------
# Knowledge base & company templates: no env vars needed. The project knowledge
# base is precomputed offline into assets/knowledge_base_vectordb.{npy,json} via
# `python build_knowledge_base.py` and shipped with the app (see README.md).
# The company template library lives at assets/company_templates.csv and can
# also be replaced at runtime from the UI (persists back to that same file).
# ---------------------------------------------------------------------------
